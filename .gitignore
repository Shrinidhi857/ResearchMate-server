# ──────────────────────────────────────────────────────────────────────────────
# ResearchMate – Git Ignore Rules
# ──────────────────────────────────────────────────────────────────────────────

# ── Secrets & Environment Variables ──────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python Artefacts & Virtual Environments ───────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
venv/
env/
.venv/
ENV/

# ── Test & Coverage Reports ───────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.log
test_researchmate.db

# ── Terraform Local Cache & Sensitive Files ───────────────────────────────────
# DO NOT ignore .tf files! Only ignore local cache, state, and secrets:
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.example.tfvars
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ── Local Vector & DB Dumps ───────────────────────────────────────────────────
db/vectorstore/
*.sqlite3
*.bin

# ── OS & IDE Files ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
.env.example