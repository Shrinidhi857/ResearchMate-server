# .dockerignore – files excluded from Docker build context

# Python artefacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
venv/
env/
.venv/

# Environment secrets & keys – NEVER include in images
.env
.env.*
*.pem
*.key
*.id_rsa
*.crt

# Test artefacts
tests/
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.log

# Version control
.git/
.gitignore
.github/

# IDE / OS
.vscode/
.idea/
*.swp
*.DS_Store
Thumbs.db

# Documentation & diagrams
*.md
diagram.png
logo.png

# Temporary & Local Storage
tmp/
temp/
storage/

# SQLite test database
*.db
